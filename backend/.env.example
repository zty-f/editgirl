# ========== LLM 配置(选一个 provider 取消注释即可) ==========

# --- OpenAI 官方 ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o

# --- DeepSeek ---
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-chat

# --- 通义千问 Qwen ---
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-your-dashscope-key
# LLM_MODEL=qwen-plus

# --- 智谱 GLM ---
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_API_KEY=your-glm-key
# LLM_MODEL=glm-4-plus

# --- Moonshot Kimi ---
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_API_KEY=sk-your-moonshot-key
# LLM_MODEL=moonshot-v1-32k

# --- Anthropic Claude ---
# LLM_PROVIDER=anthropic
# OPENAI_BASE_URL=https://api.anthropic.com
# OPENAI_API_KEY=sk-ant-your-anthropic-key
# LLM_MODEL=claude-opus-4-7

# --- 本地 Ollama ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b


# ========== 校对引擎参数(可选) ==========
USE_LLM=true
ENABLE_L4=true              # L4 专名一致性(对长稿件用)
ENABLE_L5_AI=true           # L5 接受时后台 LLM 复核
LLM_CONCURRENCY=12          # 批量并发数
LLM_CHUNK_CHARS=2400        # 每个 LLM 调用包含的字符数
L4_CANDIDATE_LIMIT=30
MIN_PARAGRAPH_LEN=8         # 短于此的段跳过 LLM
